{
    "$schema" : "commission.schema.json",
    "schema_version": 1,
    "title": "Your First House",
    "conditions": [
        {"title": "Add less than 100 blocks", "condition": "BlockAdded", "operator": "<", "threshold": 100},
        {"condition": "BlockRemoved", "operator": ">", "threshold": 400},
        {"condition": "Elevation", "operator": "<", "threshold": 64, "failureDescription": "Too high up! Is at {current_elevation}, must be at 64 or lower."}
    ],
    "unlocks": [
        {"title": "Stone", "unlock": "BlockReward", "block": "minecraft:stone", "count": 32}
    ]
}
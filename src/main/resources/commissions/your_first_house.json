{
    "$schema" : "commission.schema.json",
    "schemaVersion": 1,
    "title": "Your First House",
    "conditions": [
        {"title": "Make a house at least 8 blocks tall!", "condition": "Tallness", "operator": ">", "threshold": 7},
        {"title": "Don't make your house too small (500 blocks at least)", "condition": "TotalVolume", "operator": ">", "threshold": 500},
        {"title": "Use at least 4 stacks of your own blocks to build it!", "condition": "BlockAdded", "operator": ">", "threshold": 255},
        {"title": "Add a crafting table!", "condition": "BlockAdded", "blocks": ["minecraft:crafting_table"], "operator": ">", "threshold": 0},
        {"title": "Add a bed!", "condition": "BlockAdded", "blocks": ["#minecraft:beds"], "operator": ">", "threshold": 0}
    ]
}
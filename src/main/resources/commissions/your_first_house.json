{
    "$schema" : "commission.schema.json",
    "schemaVersion": 1,
    "title": "Your First House",
    "thumbnailPath": "your_first_house.png",
    "conditions": [
        {"title": "Make a house at least 8 blocks tall!", "condition": "Tallness", "operator": ">", "threshold": 7, "failureDescription": "House is not tall enough!"},
        {"title": "Don't make your house too small (500 blocks at least)", "condition": "TotalVolume", "operator": ">", "threshold": 500, "failureDescription": "Not enough blocks occupied by the house!"},
        {"title": "Use at least 4 stacks of your own blocks to build it!", "condition": "BlockAdded", "operator": ">", "threshold": 255, "failureDescription": "You haven't added enough blocks, only added {value}!"},
        {"title": "Add a crafting table!", "condition": "BlockAdded", "blocks": ["minecraft:crafting_table"], "operator": ">", "threshold": 0, "failureDescription": "Missing a crafting table!"},
        {"title": "Add a bed!", "condition": "BlockAdded", "blocks": ["#minecraft:beds"], "operator": ">", "threshold": 0, "failureDescription": "No beds found!"}
    ],
    "unlocks": [
        {"unlock": "ExpReward", "expType": "Levels", "expAmount": 1}
    ]
}
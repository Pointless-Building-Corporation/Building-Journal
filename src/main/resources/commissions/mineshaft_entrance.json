{
    "$schema" : "commission.schema.json",
    "schemaVersion": 1,
    "title": "Mineshaft Entrance",
    "thumbnailPath": "mineshaft_entrance.png",
    "conditions": [
        {"title": "Hollow out at least 400 blocks of space!", "condition": "BlockRemoved", "operator": ">", "threshold": 399, "failureDescription": "Only {value} blocks hollowed out!"},
        {"title": "Wooden supports hold it up!",  "condition": "BlockAdded", "blocks": ["#minecraft:planks", "#minecraft:wooden_fences"],
        "operator": ">", "threshold": 0, "failureDescription": "Missing wooden blocks!"},
        {"title": "Light it up,", "condition": "BlockAdded",
        "blocks": ["minecraft:torch", "minecraft:wall_torch", "minecraft:redstone_torch", "minecraft:redstone_wall_torch",
                   "minecraft:jack_o_lantern", "minecraft:sea_lantern", "minecraft:lantern", "minecraft:soul_lantern", "minecraft:redstone_lamp"],
        "operator": ">", "threshold": 0, "failureDescription": "Use torches or lanterns to light the entrance up!"},
        {"title": "Use chains to hang them up!", "condition": "BlockAdded", "blocks": ["minecraft:chain"], "operator": ">", "threshold": 0, "failureDescription": "No chains found!"},
        {"title": "Use minecart rails to travel around!",  "condition": "BlockAdded", "blocks": ["#minecraft:rails"], "operator": ">", "threshold": 0, "failureDescription": "No minecart tracks found!"},
        {"title": "Keep some furnaces for smelting ores down.",  "condition": "BlockAdded", "blocks": ["minecraft:furnace", "minecraft:blast_furnace"],
        "operator": ">", "threshold": 0, "failureDescription": "Place some furnaces down!"}
    ],
    "unlocks": [
        {"unlock": "ExpReward", "expType": "Levels", "expAmount": 1}
    ]
}
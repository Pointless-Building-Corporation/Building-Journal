{
    "$schema" : "commission.schema.json",
    "schemaVersion": 1,
    "title": "Farmland",
    "thumbnailPath": "farmland.png",
    "conditions": [
        {"title": "Have at least 100 farmland tiles!", "condition": "BlockAdded", "blocks": ["minecraft:farmland"], "operator": ">", "threshold": 99, "failureDescription": "Only {value} farmland tiles found!"},
        {"title": "Fence it up! Use a stack at least.",  "condition": "BlockAdded", "blocks": ["#minecraft:fences"], "operator": ">", "threshold": 63, "failureDescription": "Not enough fences! Currently only {value} present."},
        {"title": "Water is important..",  "condition": "BlockAdded", "blocks": ["minecraft:water"], "operator": ">", "threshold": 0, "failureDescription": "No water found!"},
        {"title": "... and so is light!", "condition": "BlockAdded",
        "blocks": ["minecraft:torch", "minecraft:wall_torch", "minecraft:redstone_torch", "minecraft:redstone_wall_torch",
                   "minecraft:jack_o_lantern", "minecraft:sea_lantern", "minecraft:lantern", "minecraft:soul_lantern", "minecraft:redstone_lamp"],
        "operator": ">", "threshold": 0, "failureDescription": "Light up the farm!"},
        {"title": "A composter is helpful!",  "condition": "BlockAdded", "blocks": ["minecraft:composter"], "operator": ">", "threshold": 0, "failureDescription": "You need to place down a composter!"}
    ]
}